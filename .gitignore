node_modules/
dist/
pr_code.gs
vssound_code.gs
test_gas.py
.DS_Store

# Claude Code: ignore user-local config, but track shared project rules
.claude/*
!.claude/rules/
!.claude/agents/

# Local samples / exports of real production data — never commit
sheetexample/
# Raw role/people exports (PII): xlsx + json + generated intermediate.
# The committed supabase/migrations/0047_seed_team_data.sql reproduces the
# seed without these, so the source stays local-only.
externaldata/
# Office lock/temp files
~$*

# Environment files — secrets live here
.env
.env.local
# `npm run setup` copies .env.local here before changing it. On a
# maintainer's machine that copy holds PRODUCTION credentials and the VM sudo
# password. Named exactly, not as `.env.local.*`, because that wildcard would
# also swallow `.env.local.example` — which must stay TRACKED
# (env-example.test.js asserts both halves of this).
.env.local.backup

# `npm run env:pull` keeps the Bitwarden CLI's state HERE rather than in the
# user's global config, so it can never repoint a personal `bw` at our vault.
# It holds a server URL and an encrypted local cache — never commit it.
.bw/
.env.*.local

# Supabase CLI working dir
supabase/.temp/
supabase/.branches/

# Apps Script deploy scratch (tools/deploy-gas.mjs)
.gas-build/
.gas-remote/
appscript/.clasp.json
.clasprc.json

# VitePress docs site build output (docs/ itself is tracked)
docs/.vitepress/dist/
docs/.vitepress/cache/
