# ⛔ THIS IS THE **VM's** FILE. A CONTRIBUTOR WANTS `.env.local.example`.
#
# Two files a character apart, and this one used to open with "copy this file to
# .env.local" — so the guide said one thing and the file said another. A
# contributor who copied THIS one would fill in production-shaped names and get
# a dead dev server, which is exactly the confusion of 2026-09-06.
#
# What this documents: the variables `server/deploy.sh` bakes into the
# PRODUCTION build from the VM's own .env.local. Cloudflare Pages is RETIRED —
# a variable set in that dashboard reaches nothing.
#
# Setting up to contribute? Stop here and read `docs/start/install.md`; the file
# you want is `.env.local.example`, and `npm run dev` points itself at the
# practice database (tools/dev-env.mjs).

# Public-side (exposed to browser; protected by Supabase RLS).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key-here

# Only used by tools/migrate-from-sheets.mjs — never expose this client-side.
# Generate at Supabase dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key-here

# MAINTAINER ONLY — not needed to run the app, and not to be shared.
# Management-API personal access token; the only credential that can run DDL
# (tools/apply-migration.mjs) and the live proofs (npm run proofs). It is
# ACCOUNT-WIDE: it owns every project on the account, not just this one.
# SUPABASE_ACCESS_TOKEN=sbp_...
