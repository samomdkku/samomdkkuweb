VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⛔ THIS FILE IS A HISTORICAL ARTEFACT — passport/ IS NOT AN ENV DIRECTORY.
# Since the 2026-09-04 merge the build reads the REPO ROOT `.env.local`
# (passport/vite.config.js sets `envDir`), and nothing here is loaded. It is kept
# only to document the names. Add real values to the repo root, not here.

# OVERRIDE ONLY. The upload endpoint is checked in as DEFAULT_GAS_URL in
# js/upload.js; leaving this blank is the normal, working state. It was
# env-ONLY until 2026-09-15, which is how the admin ⬆️ Upload button disappeared.
VITE_GAS_UPLOAD_URL=

# ⚠️ RENAMED TO `PASSPORT_GAS_SCRIPT_ID`, AND IT LIVES IN THE REPO ROOT .env.local.
# That file already has a `GAS_SCRIPT_ID` and it is SAMOWEB's project; pushing
# gas/Upload.gs over that one takes down PR/shop uploads and the projects email.
# Guarded by src/js/gas-project-isolation.test.js.
#
# Apps Script project id for gas/Upload.gs — required by `npm run deploy:gas:passport`.
# WITHOUT IT THE DEPLOY SILENTLY DOES NOTHING: the tool stops with
# "GAS_SCRIPT_ID is not set" and a committed GAS fix stays undeployed. That
# happened on 2026-08-09. Get it from the "samopassport" Apps Script project
# → ⚙ Project Settings → IDs → Script ID. Not a crypto secret (the /exec url is
# already public) but it decides WHICH project is written to, so the real value
# lives in .env.local, never in git.
# PASSPORT_GAS_SCRIPT_ID=   <- in the REPO ROOT .env.local, not here
