[Unit]
# ⛔ DO NOT INSTALL AS WRITTEN (owner-session review, 2026-10-20). The reason
# given below for using the Postgres SUPERUSER is FALSE: pg_proc.proacl on
# production reads {postgres=X, service_role=X} for these functions — the
# revokes never touched service_role, so a PostgREST call with the service
# key CAN run them. The superuser is the widest credential this project has;
# a weekly prune needs EXECUTE on three functions. Before installing, switch
# to a dedicated login role granted only those, or to /rest/v1/rpc/prune_*
# with the key the VM already holds (and pin that use in
# .claude/rules/security.md + its test), and add an OnFailure= alert.
# HANDOFF §22 carries this as OWED.
#
Description=Weekly stats retention (prune_analytics / prune_claude_usage_samples / prune_notify_log)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/samo-projects/samomdkkuweb
# SUPABASE_DB_URL — the project's Postgres SUPERUSER connection string.
# chmod 600, root-owned, never in git (.claude/rules/security.md). The SAME
# credential server/supabase-backup.sh uses — these prune functions are
# `security definer` and revoked from anon/authenticated/public, so only a
# direct psql connection (not a PostgREST/service_role call) can run them.
EnvironmentFile=/etc/stats-retention.env
ExecStart=/home/ubuntu/samo-projects/samomdkkuweb/server/stats-retention.sh
# The script exits non-zero on any failed prune, so a bad run shows as a
# FAILED unit rather than a silent partial success.
# Check with: systemctl status stats-retention.service
