# samo-notify.env — secrets for the notify service.
#
# Install:  sudo cp server/samo-notify.env.example /etc/samo-notify.env
#           sudo chown root:root /etc/samo-notify.env && sudo chmod 600 /etc/samo-notify.env
#           sudo nano /etc/samo-notify.env   # fill in the real values
#
# WHERE THE VALUES COME FROM: these are the exact same env vars the app used
# on Cloudflare Pages. Copy them out of the Cloudflare Pages project
# (Settings -> Environment variables) before you tear that project down.
# Discord webhook URLs are SECRETS — this file (chmod 600) is the only place
# they live on the server. Never commit real values; never put them in the
# browser bundle (.claude/rules/security.md).

# --- Discord webhooks (required for notifications to actually send) ---
DISCORD_PR_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
DISCORD_PROJECTS_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
# จองโควตา Claude (migration 0154). Without this the booking still saves and
# the board still renders — only the notification is skipped, and /notify logs
# "no webhook configured for action notifyClaudeBooking".
DISCORD_CLAUDE_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
# JSON map of { "<dept>": "<webhook url>", ... }, MUST include "SE" (fallback).
DISCORD_VS_WEBHOOKS={"SE":"https://discord.com/api/webhooks/xxx/yyy"}

# --- Optional: durable notify_log (migration 0055) ---
# Same values as the frontend's VITE_ ones. Leave BOTH unset to disable
# logging entirely (the service still delivers notifications).
# SUPABASE_URL=https://fheueuowbchsnsvbcgil.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# --- Optional: bind config (defaults shown) ---
# NOTIFY_HOST=127.0.0.1
# NOTIFY_PORT=8787

# --- Discord OAuth2, for เชื่อมบัญชี Discord (DISCORD-ROLE-SYNC.md §8e) ---
#
# The CLIENT ID is public — it travels in the authorize URL every user opens.
# The CLIENT SECRET is not, and neither is the service-role key.
#
# ⛔ SUPABASE_SERVICE_ROLE_KEY BYPASSES EVERY ROW-LEVEL SECURITY POLICY. It is
# here for exactly one call — rpc/redeem_discord_link_code, which cannot be
# granted to clients without letting one bind a link code to a Discord account
# it does not control. src/js/discord-oauth.test.js asserts it is never used
# for anything else. Never copy it to a laptop, a VITE_ var, or src/.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Used to build redirect_uri and to send the person back afterwards.
PUBLIC_ORIGIN=https://samo.md.kku.ac.th
